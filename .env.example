# =====================================================================
#  LegalMind AI configuration
#  Copy this file to ".env" (same folder) and fill in GEMINI_API_KEY.
#  The setup scripts do the copy for you. NEVER commit your .env file.
# =====================================================================

# --- Required for AI answers, analysis and evaluation -----------------
# Free key: https://aistudio.google.com/apikey
# Without it the app still runs: upload, indexing, hybrid search and
# evidence retrieval work; AI features clearly report that the key is missing.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.2

# --- Security ---------------------------------------------------------
# Long random string used to sign login tokens (setup scripts generate one).
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
RATE_LIMIT_PER_MINUTE=120
AI_RATE_LIMIT_PER_MINUTE=20
# Browser origins allowed to call the API (local dev server / Docker frontend)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# --- Database / vector store -----------------------------------------
# Docker Compose sets these automatically (PostgreSQL + Qdrant server).
# For local runs WITHOUT Docker leave them commented: SQLite + embedded Qdrant are used.
# DATABASE_URL=postgresql://legalmind:legalmind@localhost:5432/legalmind
# QDRANT_URL=http://localhost:6333
POSTGRES_PASSWORD=legalmind

# --- Documents ---------------------------------------------------------
MAX_UPLOAD_MB=25
OCR_ENABLED=true

# --- Retrieval tuning ---------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_ENABLED=true
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=20
RERANK_TOP_N=6
RRF_K=60
MAX_CONTEXT_CHARS=14000

# Load the ML models at startup (slower boot, faster first query)
PRELOAD_MODELS=true
LOG_LEVEL=INFO

# --- Docker host ports (change if another program already uses them) ---
FRONTEND_PORT=8080
BACKEND_PORT=8000
