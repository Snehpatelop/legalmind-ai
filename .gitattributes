# Keep Linux line endings for files that run inside Docker containers or bash,
# even when the repo is cloned on Windows (CRLF would break them).
* text=auto
*.sh text eol=lf
*.py text eol=lf
Dockerfile text eol=lf
*.conf text eol=lf
*.yml text eol=lf
*.ini text eol=lf
*.mako text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.pdf binary
*.png binary
